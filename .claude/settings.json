{
  "permissions": {
    "allow": [
      "Bash(npm test*)",
      "Bash(npm run typecheck*)",
      "Bash(npm run validate*)",
      "Bash(npm run check*)",
      "Bash(npm run guard*)",
      "Bash(npm run lint*)",
      "Bash(npm run e2e*)",
      "Bash(npm run mutate*)",
      "Bash(npm run check:full*)",
      "Bash(npx oxlint*)",
      "Bash(npx playwright test*)",
      "Bash(npx stryker run*)",
      "Bash(npm run factory:status*)",
      "Bash(npx vitest *)",
      "Bash(npx tsc --noEmit*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git rev-parse*)",
      "Bash(ls*)",
      "Bash(mkdir *)",
      "Bash(node scripts/validate.ts*)",
      "Bash(node scripts/fetch-quran.ts*)",
      "Bash(node scripts/factory/*)",
      "Bash(git restore *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(shasum *)",
      "Bash(sort *)",
      "Bash(diff *)",
      "Bash(cmp *)",
      "Bash(pwd)"
    ],
    "ask": ["Edit(/.githooks/**)", "Edit(/.github/workflows/**)"],
    "deny": ["Edit(/data/quran/**)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/guard-bash.ts"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/check-on-stop.ts",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
