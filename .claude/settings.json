{
  "permissions": {
    "allow": [
      "Bash(npm test*)",
      "Bash(npm run typecheck*)",
      "Bash(npm run validate*)",
      "Bash(npm run check*)",
      "Bash(npm run guard*)",
      "Bash(npm run factory:status*)",
      "Bash(npx vitest *)",
      "Bash(npx tsc --noEmit*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git rev-parse*)",
      "Bash(ls*)",
      "Bash(mkdir *)",
      "Bash(node scripts/validate.ts*)",
      "Bash(node scripts/fetch-quran.ts*)",
      "Bash(node scripts/factory/*)",
      "Bash(git restore *)"
    ],
    "ask": [
      "Edit(/.githooks/**)",
      "Edit(/.github/workflows/**)",
      "Edit(/.claude/**)",
      "Edit(/.gitattributes)",
      "Edit(/.gitignore)",
      "Edit(/factory/**)",
      "Edit(/scripts/factory/**)",
      "Edit(/scripts/validate.ts)",
      "Edit(/src/content/validate.ts)",
      "Edit(/src/content/honorifics.ts)",
      "Edit(/src/content/credits.ts)",
      "Edit(/src/content/refs.ts)",
      "Edit(/CODING_STANDARDS.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/package.json)",
      "Edit(/package-lock.json)",
      "Edit(/tsconfig*.json)",
      "Edit(/vite*.config.*)",
      "Edit(/vitest*)"
    ],
    "deny": [
      "Edit(/data/quran/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/guard-bash.ts"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/check-on-stop.ts",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
