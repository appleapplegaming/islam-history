{
  "name": "stories-of-the-prophets",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate.ts",
    "guard": "node scripts/factory/guard.ts",
    "check": "npm run typecheck && npm test && npm run validate",
    "factory:status": "node scripts/factory/status.ts",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
